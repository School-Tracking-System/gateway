# Gateway Service - Variables de Entorno
# Copiar este archivo como .env y ajustar los valores según el entorno.
# cp .env.template .env

# Puerto del servidor HTTP
PORT=8000

# Entorno de ejecución (development | production)
ENVIRONMENT=development

# URL de conexión al servicio de Autenticación
AUTH_SERVICE_URL=http://localhost:8080

# URL de conexión al servicio de Fleet (gRPC)
FLEET_SERVICE_URL=localhost:9090

# URL de conexión al servicio de Trip (gRPC)
TRIP_SERVICE_URL=localhost:9092

# URL de conexión al servicio de Notification (gRPC)
NOTIFICATION_SERVICE_URL=localhost:9095

# Secreto para firmar JWT (CAMBIAR EN PRODUCCION)
# Debe coincidir exactamente con el JWT_SECRET configurado en el servicio Auth
JWT_SECRET=dev-secret-change-in-prod
